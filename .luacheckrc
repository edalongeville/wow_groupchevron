-- luacheck configuration for the GroupChevron addon (Lua 5.1, as embedded in the WoW client).
std = "lua51"
max_line_length = 120

-- Globals the addon defines.
globals = {
  "SlashCmdList",
  "GroupChevronDB", -- SavedVariables of GroupChevron
  "SLASH_GROUPCHEVRON1",
}

